#!/bin/sh
# Right-hand status line. Runs every status-interval in every attached client,
# so every command here stays cheap — no top(1)/iostat sampling.
set -u

dir=${1:-$HOME}
sep="#[fg=white]│#[default]"

branch=$(cd "$dir" 2>/dev/null && git branch --show-current 2>/dev/null)

# Load average is a share of the cores, not a sampled percentage, so it can
# exceed 100 when work is queued.
if [ "$(uname)" = Darwin ]; then
  set -- $(sysctl -n vm.loadavg)        # { 1m 5m 15m }
  load=$2
  cores=$(sysctl -n hw.ncpu)
else
  load=$(cut -d' ' -f1 /proc/loadavg)
  cores=$(nproc)
fi
cpu=$(awk -v l="$load" -v c="$cores" 'BEGIN { printf "%d", (l / c) * 100 }')
if [ "$cpu" -ge 100 ]; then cpu_c=red
elif [ "$cpu" -ge 60 ]; then cpu_c=yellow
else cpu_c=green
fi

# "Used" means unavailable to a new process, not resident: MemAvailable already
# discounts the reclaimable page cache, which is what memory_pressure reports too.
if [ "$(uname)" = Darwin ]; then
  mem=$(memory_pressure 2>/dev/null | awk '/free percentage/ { gsub("%", "", $NF); print 100 - $NF }')
else
  mem=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 }
             END { if (t) printf "%d", (1 - a / t) * 100 }' /proc/meminfo 2>/dev/null)
fi
if [ -z "$mem" ]; then mem=??; mem_c=white
elif [ "$mem" -ge 90 ]; then mem_c=red
elif [ "$mem" -ge 75 ]; then mem_c=yellow
else mem_c=green
fi

if [ "$(uname)" = Darwin ]; then
  pm=$(pmset -g batt 2>/dev/null)
  batt=$(printf '%s\n' "$pm" | awk 'NR == 2 { gsub("[%;]", "", $3); print $3 }')
  case $pm in
    *"AC Power"*) ac="+" ;;
    *) ac="" ;;
  esac
else
  # scope=Device filters out peripheral batteries — a wireless mouse registers as
  # a power supply too, and its charge is not what this segment is about.
  batt="" ac="" found=""
  for p in /sys/class/power_supply/*; do
    [ -d "$p" ] || continue
    [ "$(cat "$p/scope" 2>/dev/null)" = Device ] && continue
    found=1
    case $(cat "$p/type" 2>/dev/null) in
      Battery)
        [ -r "$p/capacity" ] || continue
        batt=$(cat "$p/capacity")
        case $(cat "$p/status" 2>/dev/null) in
          Charging|Full|"Not charging") ac="+" ;;
        esac
        ;;
      Mains)
        [ "$(cat "$p/online" 2>/dev/null)" = 1 ] && ac="+"
        ;;
    esac
  done
fi

if [ -z "$batt" ] && [ -z "${found-x}" ]; then batt_c=white        # desktop: no segment
elif [ -z "$batt" ] && [ -n "$ac" ]; then batt_c=white            # on mains, no battery
elif [ -z "$batt" ]; then batt=??; batt_c=white
elif [ -n "$ac" ] || [ "$batt" -ge 40 ]; then batt_c=green
elif [ "$batt" -ge 20 ]; then batt_c=yellow
else batt_c=red
fi

[ -n "$branch" ] && printf '#[fg=cyan]%s#[default] %s ' "$branch" "$sep"
printf '#[fg=%s]cpu %s%%#[default] %s ' "$cpu_c" "$cpu" "$sep"
printf '#[fg=%s]mem %s%%#[default] %s ' "$mem_c" "$mem" "$sep"
[ -n "$batt" ] && printf '#[fg=%s]bat %s%%%s#[default] %s ' "$batt_c" "$batt" "$ac" "$sep"
exit 0
